\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {3-D loss surfaces at memorisation (left) and post-grokking (right).} Both panels use identical filter-normalised weight-space directions and a shared colour scale. The memorisation basin (step~$1{,}666$, test~$34\%$) is a sharp bowl with high curvature in all visible directions. The Fourier basin (step~$5{,}000$, test~$100\%$) is a flat plateau with loss variations an order of magnitude smaller—directly visualising the $24\times $ drop in $\operatorname  {tr}(H)$.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:surface3d}{{6}{9}{\textbf {3-D loss surfaces at memorisation (left) and post-grokking (right).} Both panels use identical filter-normalised weight-space directions and a shared colour scale. The memorisation basin (step~$1{,}666$, test~$34\%$) is a sharp bowl with high curvature in all visible directions. The Fourier basin (step~$5{,}000$, test~$100\%$) is a flat plateau with loss variations an order of magnitude smaller—directly visualising the $24\times $ drop in $\operatorname {tr}(H)$}{figure.6}{}}
\newlabel{fig:surface3d@cref}{{[figure][6][]6}{[1][7][]9}{}{}{}}
