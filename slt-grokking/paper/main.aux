\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Left — Geometric phase portrait.} Trajectory in $(\operatorname  {tr}(H),\,\hat  \lambda )$ space (log x-axis), coloured by training step (dark = early, yellow = late). Hessian curvature separates the memorisation and Fourier basins; SGLD-LLC does not. \textbf  {Right — Effective rank trajectory.} $\operatorname  {tr}(H)/\lambda _{\max }$ is noisy during memorisation and stabilises at $\approx \!36$ post-grokking (Hessian-LLC $\approx 18$; dashed = Fourier prediction $\approx 40$). Rank stability is a task-agnostic circuit-crystallisation diagnostic.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:portrait}{{4}{7}{\textbf {Left — Geometric phase portrait.} Trajectory in $(\operatorname {tr}(H),\,\hat \lambda )$ space (log x-axis), coloured by training step (dark = early, yellow = late). Hessian curvature separates the memorisation and Fourier basins; SGLD-LLC does not. \textbf {Right — Effective rank trajectory.} $\operatorname {tr}(H)/\lambda _{\max }$ is noisy during memorisation and stabilises at $\approx \!36$ post-grokking (Hessian-LLC $\approx 18$; dashed = Fourier prediction $\approx 40$). Rank stability is a task-agnostic circuit-crystallisation diagnostic}{figure.4}{}}
\newlabel{fig:portrait@cref}{{[figure][4][]4}{[1][4][]7}{}{}{}}
