\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {LLC–Hessian dissociation ($110\times $ post-grokking).} \emph  {Left:} SGLD-LLC (purple) and $\hat  \lambda _H = \operatorname  {tr}(H) /(2\lambda _{\max })$ (teal) on a shared log axis, with test accuracy (green dots). Post-grokking, $\hat  \lambda _H$ converges to $\approx \!18$ (matching $\sim \!10$ Fourier frequencies $\times $ $2$ parameters) while SGLD-LLC remains $\approx \!2{,}000$. \emph  {Right:} SGLD/Hessian-LLC ratio on a log scale, stabilising at $\sim \!110\times $ once the Fourier solution is established. The dissociation itself is a clean phase-transition marker.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:dissociation}{{2}{5}{\textbf {LLC–Hessian dissociation ($110\times $ post-grokking).} \emph {Left:} SGLD-LLC (purple) and $\hat \lambda _H = \operatorname {tr}(H) /(2\lambda _{\max })$ (teal) on a shared log axis, with test accuracy (green dots). Post-grokking, $\hat \lambda _H$ converges to $\approx \!18$ (matching $\sim \!10$ Fourier frequencies $\times $ $2$ parameters) while SGLD-LLC remains $\approx \!2{,}000$. \emph {Right:} SGLD/Hessian-LLC ratio on a log scale, stabilising at $\sim \!110\times $ once the Fourier solution is established. The dissociation itself is a clean phase-transition marker}{figure.2}{}}
\newlabel{fig:dissociation@cref}{{[figure][2][]2}{[1][3][]5}{}{}{}}
