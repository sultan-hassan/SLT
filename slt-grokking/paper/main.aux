\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Fourier bridge: mechanistic interpretability meets SLT.} \emph  {Left:} Token-embedding Fourier spectrum (frequency $k$ vs.\ training step); bright colours indicate high amplitude. $\sim \!12$ frequencies light up simultaneously at the grokking transition (vertical green dashed line). \emph  {Right:} Number of active frequencies (orange) and Hessian-LLC $\hat  \lambda _H$ (teal) converge at the same transition step, with test accuracy (dotted green) shown for reference. The quantitative match ($12 \times 2 = 24 \approx \hat  \lambda _H = 18$) requires no hand-crafted Fourier projections on the SLT side.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:fourier}{{3}{6}{\textbf {Fourier bridge: mechanistic interpretability meets SLT.} \emph {Left:} Token-embedding Fourier spectrum (frequency $k$ vs.\^^Mtraining step); bright colours indicate high amplitude. $\sim \!12$ frequencies light up simultaneously at the grokking transition (vertical green dashed line). \emph {Right:} Number of active frequencies (orange) and Hessian-LLC $\hat \lambda _H$ (teal) converge at the same transition step, with test accuracy (dotted green) shown for reference. The quantitative match ($12 \times 2 = 24 \approx \hat \lambda _H = 18$) requires no hand-crafted Fourier projections on the SLT side}{figure.3}{}}
\newlabel{fig:fourier@cref}{{[figure][3][]3}{[1][4][]6}{}{}{}}
