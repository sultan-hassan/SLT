\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Grokking training arc.} Three phases: fast memorisation (blue band, steps 0--500), memorisation plateau (orange, 500--1\,900), and grokking transition (green, 1\,900--2\,600). Test loss peaks above the random-chance baseline during the plateau (left panel), confirming the lookup table actively suppresses generalisation. Phase annotations are consistent across all figures.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:training}{{1}{4}{\textbf {Grokking training arc.} Three phases: fast memorisation (blue band, steps 0--500), memorisation plateau (orange, 500--1\,900), and grokking transition (green, 1\,900--2\,600). Test loss peaks above the random-chance baseline during the plateau (left panel), confirming the lookup table actively suppresses generalisation. Phase annotations are consistent across all figures}{figure.1}{}}
\newlabel{fig:training@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
